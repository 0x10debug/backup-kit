# strategies/restic-sftp/.env.example
# Copy to .env and fill in your credentials. NEVER commit the real .env.

# ── Required ─────────────────────────────────────────────────────────────────
RESTIC_REPOSITORY=sftp:user@host:/path/to/repo
SFTP_PASSWORD=
RESTIC_PASSWORD=

# ── Optional (defaults shown) ────────────────────────────────────────────────
# BACKUP_PATHS=/data
# RETENTION_DAILY=7
# RETENTION_WEEKLY=4
# RETENTION_MONTHLY=6
