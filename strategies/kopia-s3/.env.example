# strategies/kopia-s3/.env.example
# Copy to .env and fill in your credentials. NEVER commit the real .env.

# ── Required ─────────────────────────────────────────────────────────────────
KOPIA_REPOSITORY=s3-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KOPIA_PASSWORD=

# ── Optional (defaults shown) ────────────────────────────────────────────────
# BACKUP_PATHS=/data
# RETENTION_DAILY=7
# RETENTION_WEEKLY=4
# RETENTION_MONTHLY=6
