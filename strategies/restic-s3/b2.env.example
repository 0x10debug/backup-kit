# strategies/restic-s3/b2.env.example
# Backblaze B2 backend for Restic.
# Copy to .env and fill in your credentials. NEVER commit the real .env.
#
# Backblaze B2 offers two ways to use it with Restic:
#
#   1. Native B2 support (RECOMMENDED for new repos)
#      Restic has first-class B2 support via the "b2:" scheme. It uses the B2
#      native API directly and is faster / simpler than the S3 compatibility
#      layer. Use B2_ACCOUNT_ID / B2_ACCOUNT_KEY (not AWS_* keys).
#
#   2. S3-compatible mode
#      B2 also exposes an S3-compatible endpoint. Use this only if you are
#      migrating an existing s3: repo to B2 without re-initializing, or if a
#      tool in your pipeline only speaks S3. Set RESTIC_REPOSITORY to the
#      s3: scheme and use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (the S3
#      keys you generate in the B2 console, NOT the master account key).
#
# This template defaults to the native B2 mode. See the commented S3 block
# below if you need S3-compatible mode.
# Homepage: https://www.backblaze.com/b2

# ── Required (native B2 mode) ────────────────────────────────────────────────
# Restic B2 repository. Format: b2:<bucket-name>:<path>
RESTIC_REPOSITORY=b2:my-backup-bucket:/restic

# B2 Application Key ID and Application Key.
# Create a non-master App Key in the B2 console (Buckets → App Keys).
# Scope it to the single bucket you use for backups. NEVER use the master key.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Restic repository encryption passphrase. Keep this safe — without it your
# backup is unrecoverable. Store a copy in a password manager or offline.
RESTIC_PASSWORD=

# ── S3-compatible mode (optional, uncomment to use) ───────────────────────────
# Use this ONLY if you must keep an existing s3: repo. Generate S3-compatible
# keys in the B2 console (these differ from the native B2 App Key above).
#RESTIC_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/my-backup-bucket
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# (comment out the B2_ACCOUNT_ID / B2_ACCOUNT_KEY lines above when using S3 mode)

# ── Optional (defaults shown) ────────────────────────────────────────────────
# BACKUP_PATHS=/data
# RETENTION_DAILY=7
# RETENTION_WEEKLY=4
# RETENTION_MONTHLY=6
# RETENTION_YEARLY=1

# ── Exclusion patterns (optional) ────────────────────────────────────────────
# EXCLUDE_PATTERN=--exclude=/data/*/cache
# EXCLUDE_PATTERN=--exclude=/data/*/logs
# EXCLUDE_PATTERN=--exclude='*.tmp'
# EXCLUDE_PATTERN=--exclude=node_modules

# ── B2 notes ─────────────────────────────────────────────────────────────────
# * B2 charges for downloads (egress) above the free daily 1GB/GB-A-day quota.
#   Restore drills that pull large amounts of data will incur egress costs.
# * Class B/C transactions (small file metadata ops) are metered; Restic's
#   chunked design keeps these reasonable but very small files add up.
# * Bucket can be private or public; Restic encrypts everything regardless.
# * Native b2: mode is preferred: fewer API translations, better error
#   messages, and direct support for B2 large-file semantics.
# * Recommended: enable B2 Bucket "Object Lock" only if you understand
#   immutability interactions with restic forget/prune.
