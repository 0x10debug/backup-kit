# strategies/restic-s3/wasabi.env.example
# Wasabi hot-cloud-storage backend for Restic.
# Copy to .env and fill in your credentials. NEVER commit the real .env.
#
# Wasabi is an S3-compatible object storage with no egress fees and a flat
# single-tier price. Good for backup workloads with frequent restores.
# Homepage: https://wasabi.com

# ── Required ─────────────────────────────────────────────────────────────────
# Restic S3 repository. Format: s3:https://<endpoint>/<bucket>/<path>
# Pick the endpoint that matches your Wasabi region (see REGION below).
RESTIC_REPOSITORY=s3:https://s3.us-east-1.wasabisys.com/my-backup-bucket

# Wasabi Access Key and Secret Key (created in the Wasabi console under
# "Access Keys"). These are NOT your Wasabi console login credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Restic repository encryption passphrase. Keep this safe — without it your
# backup is unrecoverable. Store a copy in a password manager or offline.
RESTIC_PASSWORD=

# ── Wasabi region (informational) ─────────────────────────────────────────────
# Wasabi regions and their S3 endpoints:
#   us-east-1       s3.us-east-1.wasabisys.com
#   us-east-2       s3.us-east-2.wasabisys.com
#   us-central-1    s3.us-central-1.wasabisys.com
#   us-west-1       s3.us-west-1.wasabisys.com
#   eu-central-1    s3.eu-central-1.wasabisys.com
#   eu-west-1       s3.eu-west-1.wasabisys.com
#   eu-west-2       s3.eu-west-2.wasabisys.com
#   ap-northeast-1  s3.ap-northeast-1.wasabisys.com
#   ap-southeast-1  s3.ap-southeast-1.wasabisys.com
# Choose the region closest to your VPS to minimize latency.
#WASABI_REGION=us-east-1

# ── Optional (defaults shown) ────────────────────────────────────────────────
# BACKUP_PATHS=/data
# RETENTION_DAILY=7
# RETENTION_WEEKLY=4
# RETENTION_MONTHLY=6
# RETENTION_YEARLY=1

# ── Exclusion patterns (optional) ────────────────────────────────────────────
# EXCLUDE_PATTERN=--exclude=/data/*/cache
# EXCLUDE_PATTERN=--exclude=/data/*/logs
# EXCLUDE_PATTERN=--exclude='*.tmp'
# EXCLUDE_PATTERN=--exclude=node_modules

# ── Wasabi notes ─────────────────────────────────────────────────────────────
# * No egress fees: restores and downloads are free (unlike AWS S3).
# * No API request fees for PUT/GET/DELETE (within fair use).
# * Minimum 90-day storage duration per object — deleting objects before
#   90 days still incurs the remaining storage charge. Plan retention
#   accordingly: keep-daily >= 90 is not required, but frequent churn of
#   very short-lived snapshots can cost more than expected.
# * Bucket name must be globally unique within Wasabi.
# * TLS is used automatically (https:// endpoint). No extra config needed.
