# strategies/restic-s3/.env.example
# Copy to .env and fill in your credentials. NEVER commit the real .env.

# ── Required ─────────────────────────────────────────────────────────────────
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=

# ── Optional (defaults shown) ────────────────────────────────────────────────
# BACKUP_PATHS=/data
# RETENTION_DAILY=7
# RETENTION_WEEKLY=4
# RETENTION_MONTHLY=6

# ── Exclusion patterns (optional) ────────────────────────────────────────────
# EXCLUDE_PATTERN=--exclude=/data/*/cache
