# strategies/restic-s3/minio.env.example
# MinIO self-hosted S3 backend for Restic.
# Copy to .env and fill in your credentials. NEVER commit the real .env.
#
# MinIO is an S3-compatible object storage server you run yourself — on a
# second VPS, a home server, or a NAS. It gives you full control and zero
# per-GB cloud fees (you only pay for your own hardware/bandwidth). Use it
# when you want the 3-2-1 "second media" copy to be under your own roof.
# Homepage: https://min.io
#
# A ready-to-run MinIO server docker-compose template lives alongside this
# file: strategies/restic-s3/minio-docker-compose.yml

# ── Required ─────────────────────────────────────────────────────────────────
# Restic S3 repository pointing at your MinIO instance.
# Format: s3:https://<endpoint>:<port>/<bucket>/<path>
# Use the MinIO API port (9000 by default), NOT the console port (9001).
# For a local MinIO on the same host, use https://127.0.0.1:9000.
RESTIC_REPOSITORY=s3:https://minio.example.com:9000/my-backup-bucket/restic

# MinIO Access Key and Secret Key. Create these in the MinIO console or via
# `mc admin user add`. Use a dedicated user scoped to the backup bucket,
# not the root credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Restic repository encryption passphrase. Keep this safe — without it your
# backup is unrecoverable. Store a copy in a password manager or offline.
RESTIC_PASSWORD=

# ── TLS (required for production) ─────────────────────────────────────────────
# Restic requires TLS for S3 endpoints. Options:
#   A) Real certificate (recommended): put a valid cert (Let's Encrypt, etc.)
#      on the MinIO server and use https:// in RESTIC_REPOSITORY. No extra
#      env needed.
#   B) Self-signed cert: export the CA so Restic trusts it.
#      Set AWS_CA_BUNDLE to your CA pem file, e.g.:
#AWS_CA_BUNDLE=/etc/ssl/minio-ca.pem
#      Or, for testing only, disable verification (NOT for production):
#      export RESTIC_REPOSITORY with http:// and add to env:
#AWS_ENDPOINT_URL_INSECURE=true   # restic/AWS SDK v2 flag; testing only

# ── Optional (defaults shown) ────────────────────────────────────────────────
# BACKUP_PATHS=/data
# RETENTION_DAILY=7
# RETENTION_WEEKLY=4
# RETENTION_MONTHLY=6
# RETENTION_YEARLY=1

# ── Exclusion patterns (optional) ────────────────────────────────────────────
# EXCLUDE_PATTERN=--exclude=/data/*/cache
# EXCLUDE_PATTERN=--exclude=/data/*/logs
# EXCLUDE_PATTERN=--exclude='*.tmp'
# EXCLUDE_PATTERN=--exclude=node_modules

# ── MinIO notes ──────────────────────────────────────────────────────────────
# * Self-hosted: you own the hardware, the data, and the bandwidth. No cloud
#   per-GB or egress fees, but you are responsible for durability (use RAID
#   or a multi-drive MinIO erasure-coded deployment).
# * TLS: Restic refuses plain http:// S3 endpoints by default. Always run
#   MinIO with TLS in production. See minio-docker-compose.yml for a
#   volume-mounted cert setup.
# * Distributed mode: for >1 node, run MinIO in distributed/erasure-coded
#   mode (multiple minio services, same MINIO_VOLUMES spanning hosts). This
#   gives bit-rot protection and node-failure tolerance. Single-node mode is
#   fine for a secondary backup target but is NOT a substitute for RAID.
# * Keep the MinIO server on a DIFFERENT host than the data you are backing
#   up — otherwise a single host failure takes out both the data and the
#   backup, defeating the 3-2-1 rule.
# * Bucket versioning: enable it on the MinIO bucket for extra protection
#   against accidental `restic forget` / object deletion.
