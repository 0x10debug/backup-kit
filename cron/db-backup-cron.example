# cron/db-backup-cron.example — Scheduled database-aware backup tasks
#
# Install with:
#   crontab /etc/mb-backup/db-backup-cron
# Or merge with existing crontab:
#   crontab -l | cat - /etc/mb-backup/db-backup-cron | crontab -
#
# This template chains database dumps before the regular backup so that
# the Restic/Kopia snapshot includes consistent database images.
# Adjust paths if mb is installed elsewhere. The MB_BACKUP_DIR environment
# variable is exported so the mb CLI can locate its libraries and strategies.

MB_BACKUP_DIR=/opt/mb-backup
export MB_BACKUP_DIR

# ── Daily database dumps at 2:55 AM ──────────────────────────────────────────
# Dumps all auto-discovered databases to /backup/db-dumps-<ts>/.
# --keep ensures the dumps survive until the 3:00 AM backup captures them.
# The cleanup line removes the dump directory after the backup completes.
55 2 * * * ${MB_BACKUP_DIR}/mb backup db-backup --auto --keep >> /var/log/mb-backup.log 2>&1

# ── Daily backup at 3:00 AM ──────────────────────────────────────────────────
# Runs a full backup with the configured strategy. The dump directory
# /backup/db-dumps-* is included if it matches your BACKUP_PATHS or is
# added as an extra path. After the backup, clean up the dump directory.
0 3 * * * ${MB_BACKUP_DIR}/mb backup run >> /var/log/mb-backup.log 2>&1 && rm -rf /backup/db-dumps-*

# ── Weekly integrity verification at 4:00 AM on Sundays ──────────────────────
0 4 * * 0 ${MB_BACKUP_DIR}/mb backup verify >> /var/log/mb-backup.log 2>&1

# ── Monthly recovery drill at 5:00 AM on the 1st ─────────────────────────────
0 5 1 * * ${MB_BACKUP_DIR}/mb backup drill >> /var/log/mb-backup.log 2>&1

# ── Monthly 3-2-1 compliance check at 6:00 AM on the 1st ─────────────────────
0 6 1 * * ${MB_BACKUP_DIR}/mb backup compliance >> /var/log/mb-backup.log 2>&1
